# Copy this file to .env before launching the local stack.  Replace all values.
SMART_PORT_ENV=development
SMART_PORT_JWT_SECRET=replace-with-a-long-random-secret
SMART_PORT_DEMO_ADMIN_PASSWORD=replace-admin-password
SMART_PORT_DEMO_OPERATOR_PASSWORD=replace-operator-password
SMART_PORT_DRONE_TOKEN=replace-drone-simulator-token
SMART_PORT_ROBOT_TOKEN=replace-robot-simulator-token

# Local defaults (optional)
SMART_PORT_MQTT_HOST=localhost
SMART_PORT_MQTT_PORT=1883
SMART_PORT_UDP_HOST=0.0.0.0
SMART_PORT_UDP_PORT=9000
SMART_PORT_CORS_ORIGINS=http://localhost:3000
