  "architecture": {
    "target": "MQTT/Mosquitto -> FastAPI -> normalization -> ML -> SIEM -> alerts/incidents -> dashboard React",
    "actual_pipeline": [
      "Mosquitto subscribes port/# and drone/#",
      "backend.mqtt_listener decodes JSON and enqueues into bounded asyncio queue",
      "mqtt_worker normalizes, writes Data Lake, persists telemetry, evaluates rules and ML",
      "alerts and SIEM events are persisted; ActionDispatcher may create incident and mission",
      "mission is published to drone/mission; simulator returns drone telemetry/events",
      "backend broadcasts selected updates over /ws",
      "dashboard combines WebSocket events with 5-second REST polling"
    ],
    "drone_boundary": "External deterministic MQTT simulator, not a real IoT asset",
